# FastAPI backend base URL, used server-side by the BFF route handlers
# (src/app/api/*). The browser never sees it. Defaults to http://localhost:8000.
# In production, point this at the backend App Runner service URL.
BACKEND_URL=http://localhost:8000

# Demo protection. UNSET or anything but "0" means ON (fail closed):
#   - file uploads are refused; only the bundled samples in public/samples/ run
#   - per-IP rate limits apply (see below)
# Set to 0 for local development so you can feed it your own case files.
DEMO_MODE=0

# Shared secret sent to the backend as x-internal-token. The backend requires it
# only when INTERNAL_API_TOKEN is set there too, so leaving both unset is fine
# locally. Set both (to the same value) in production, where the API has its own
# public App Runner URL and would otherwise be callable directly. See ADR 0013.
INTERNAL_API_TOKEN=

# Per-IP limits, per 10-minute window. Triage is the expensive one (~20s and
# several LLM calls per run).
RATE_LIMIT_TRIAGE=5
RATE_LIMIT_QUERY=20
RATE_LIMIT_APPROVE=30

# Total triage runs allowed per day across ALL visitors. The per-IP limit above
# caps one visitor; this caps the bill. Exact only while the service runs a
# single instance (App Runner is deployed with maxSize=1). A hard spending cap
# set at the LLM provider is still the real backstop.
GLOBAL_DAILY_TRIAGE=40
